{
  "manifest_version": 3,
  "name": "EchoGPT",
  "version": "1.0.0",
  "description": "Your multi-model AI assistant, right in your browser.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open EchoGPT"
    }
  }
}